---
import { services } from '../data/services';
---

<section class="section services" id="services" aria-labelledby="services-title">
  <div class="wrap">
    <div class="services__head">
      <p class="micro" data-reveal>What we do</p>
      <h2 class="headline center" id="services-title" data-reveal>Good marketing.<br /><em>Considered from every angle.</em></h2>
    </div>

    <ol class="services__list">
      {
        services.map((s, i) => (
          <li class="service" data-reveal>
            <span class="service__num micro">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="service__title">
              {s.display[0]} <em>{s.display[1]}</em>
            </h3>
            <ul class="service__items">
              {s.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <div class="services__foot" data-reveal>
      <a class="btn btn--ink" href="#contact">Start a conversation</a>
    </div>
  </div>
</section>

<style>
  .services {
    background: var(--bone);
  }
  .services__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
    margin-bottom: clamp(3.5rem, 7vw, 6rem);
  }
  .services__head .micro {
    margin: 0;
    color: var(--muted);
  }
  .services__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--line);
  }
  .service {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: baseline;
    padding-block: clamp(1.6rem, 3vw, 2.4rem);
    border-top: 1px solid var(--line);
  }
  .service__num {
    color: var(--muted);
  }
  .service__title {
    margin: 0;
    font-family: var(--serif);
    font-weight: 400;
    font-variation-settings: 'opsz' 22;
    font-size: clamp(1.6rem, 1.1rem + 1.9vw, 2.9rem);
    line-height: 1.05;
    text-transform: uppercase;
    transition: transform 0.7s var(--ease);
  }
  .service__title em {
    text-transform: none;
  }
  .service:hover .service__title {
    transform: translateX(0.4rem);
  }
  .service__items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.25rem 1.5rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .services__foot {
    display: flex;
    justify-content: center;
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }
  @media (max-width: 860px) {
    .service {
      grid-template-columns: 2.5rem 1fr;
      row-gap: 1rem;
    }
    .service__items {
      grid-column: 2;
    }
  }
  @media (max-width: 480px) {
    .service__items {
      grid-template-columns: 1fr;
    }
  }
</style>
