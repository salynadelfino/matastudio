---
import { services } from '../data/services';
---

<section class="section services" id="services" aria-labelledby="services-title">
  <div class="wrap">
    <div class="services__head">
      <p class="label" data-reveal><span class="num">02</span> What we do</p>
      <h2 class="display h2" id="services-title" data-reveal-lines>
        <span class="line"><span style="--i:0">Good marketing.</span></span>
        <span class="line"><span style="--i:1">Considered from</span></span>
        <span class="line"><span style="--i:2"><em>every angle.</em></span></span>
      </h2>
    </div>

    <ol class="services__list">
      {
        services.map((s, i) => (
          <li class="service" data-reveal style={`--d:${i % 3}`}>
            <span class="service__num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="service__title">{s.title}</h3>
            <ul class="service__items">
              {s.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <div class="services__foot" data-reveal>
      <p>Need one of these, or all of them? Every engagement starts with a conversation.</p>
      <a href="#contact" class="link">Start one</a>
    </div>
  </div>
</section>

<style>
  .services {
    background: var(--paper);
  }
  .services__head {
    display: grid;
    gap: 2.5rem;
    margin-bottom: clamp(3.5rem, 8vw, 6.5rem);
  }
  .services__head .line:nth-child(3) {
    padding-left: 1.4em;
  }
  .services__head em {
    color: var(--olive);
  }
  .services__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--line);
  }
  .service {
    position: relative;
    display: grid;
    grid-template-columns: 5rem minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: baseline;
    padding-block: clamp(1.5rem, 3vw, 2.4rem);
    border-top: 1px solid var(--line);
  }
  .service::before {
    content: '';
    position: absolute;
    left: 0;
    top: -1px;
    height: 1px;
    width: 100%;
    background: var(--espresso);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.8s var(--ease);
  }
  .service:hover::before {
    transform: scaleX(1);
  }
  .service__num {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--clay);
    transition: color 0.5s var(--ease);
  }
  .service__title {
    margin: 0;
    font-family: var(--serif);
    font-weight: 300;
    font-variation-settings: 'opsz' 96;
    font-size: clamp(1.9rem, 1.2rem + 2.6vw, 3.6rem);
    letter-spacing: -0.03em;
    line-height: 1;
    transition: transform 0.7s var(--ease);
  }
  .service:hover .service__title {
    transform: translateX(0.5rem);
  }
  .service:hover .service__num {
    color: var(--olive);
  }
  .service__items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.3rem 1.5rem;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .service__items li::before {
    content: '';
    display: inline-block;
    width: 0.6rem;
    height: 1px;
    margin-right: 0.6rem;
    vertical-align: middle;
    background: var(--clay);
  }
  @media (max-width: 480px) {
    .service__items { grid-template-columns: 1fr; }
  }

  .services__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: 2.5rem;
    font-size: 0.95rem;
  }
  .services__foot p {
    margin: 0;
    color: var(--muted);
  }
  .services__foot .link {
    font-weight: 500;
  }

  @media (max-width: 860px) {
    .service {
      grid-template-columns: 2.75rem 1fr;
      row-gap: 0.9rem;
    }
    .service__items {
      grid-column: 2;
    }
  }
</style>
