---
import Wordmark from './Wordmark.astro';
import { nav, site } from '../data/site';
const links = nav.filter((n) => n.label !== 'Home');
---

<header class="nav" data-nav>
  <div class="wrap nav__inner">
    <a href="#top" class="nav__brand" aria-label={`${site.name} — back to top`}>
      <Wordmark class="nav__mark" />
    </a>

    <nav class="nav__links" aria-label="Primary">
      <ul>
        {
          links.map((item) => (
            <li>
              <a class="micro" href={item.href} data-nav-link>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
      <span class="visually-hidden">Menu</span>
      <span class="bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>
</header>

<div class="menu" id="menu" data-menu hidden>
  <nav class="wrap menu__inner" aria-label="Mobile">
    <ol>
      {
        nav.map((item, i) => (
          <li style={`--i:${i}`}>
            <a href={item.href} data-menu-link>
              {item.label}
            </a>
          </li>
        ))
      }
    </ol>
    <div class="menu__foot micro">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <span>{site.location}</span>
    </div>
  </nav>
</div>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    color: var(--paper);
    transition:
      background-color 0.6s var(--ease),
      color 0.6s var(--ease),
      box-shadow 0.6s var(--ease),
      transform 0.6s var(--ease);
  }
  .nav.is-scrolled,
  .nav.is-menu-open {
    color: var(--ink);
    background: rgba(247, 245, 241, 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .nav.is-scrolled {
    box-shadow: 0 1px 0 var(--line);
  }
  .nav.is-hidden {
    transform: translateY(-100%);
  }
  .nav__inner {
    height: var(--nav-h);
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .nav__brand {
    position: relative;
    display: grid;
    align-items: center;
    margin-right: auto;
    text-decoration: none;
  }
  .nav__tag,
  .nav__brand :global(.nav__mark) {
    grid-area: 1 / 1;
    transition:
      opacity 0.5s var(--ease),
      transform 0.5s var(--ease);
  }
  .nav__brand :global(.nav__mark) {
    opacity: 0;
    transform: translateY(6px);
  }
  .nav.is-scrolled .nav__tag,
  .nav.is-menu-open .nav__tag {
    opacity: 0;
    transform: translateY(-6px);
  }
  .nav.is-scrolled :global(.nav__mark),
  .nav.is-menu-open :global(.nav__mark) {
    opacity: 1;
    transform: none;
  }

  .nav__links ul {
    display: flex;
    gap: 2.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__links a {
    position: relative;
    text-decoration: none;
  }
  .nav__links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0.24em;
    bottom: -3px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.5s var(--ease);
  }
  .nav__links a:hover::after,
  .nav__links a.is-active::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav__toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.6rem;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .bars {
    display: grid;
    gap: 4px;
    width: 22px;
    margin: auto;
  }
  .bars span {
    height: 1px;
    background: currentColor;
    transition:
      transform 0.45s var(--ease),
      opacity 0.3s;
  }
  .nav__toggle[aria-expanded='true'] .bars span:nth-child(1) {
    transform: translateY(5px) rotate(45deg);
  }
  .nav__toggle[aria-expanded='true'] .bars span:nth-child(2) {
    opacity: 0;
  }
  .nav__toggle[aria-expanded='true'] .bars span:nth-child(3) {
    transform: translateY(-5px) rotate(-45deg);
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: var(--paper);
    padding-top: calc(var(--nav-h) + 3rem);
    display: flex;
    flex-direction: column;
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }
  .menu[hidden] {
    display: none;
  }
  .menu.is-open {
    opacity: 1;
  }
  .menu__inner {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding-bottom: 2rem;
  }
  .menu ol {
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: center;
  }
  .menu li {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.6s var(--ease),
      transform 0.6s var(--ease);
    transition-delay: calc(var(--i) * 50ms + 80ms);
  }
  .menu.is-open li {
    opacity: 1;
    transform: none;
  }
  .menu li a {
    display: block;
    padding: 0.55rem 0;
    font-family: var(--serif);
    font-variation-settings: 'opsz' 22;
    font-size: clamp(2rem, 9vw, 3rem);
    font-weight: 400;
    text-transform: uppercase;
    line-height: 1.1;
    text-decoration: none;
  }
  .menu li:nth-child(even) a {
    font-style: italic;
    text-transform: lowercase;
  }
  .menu__foot {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--muted);
  }
  .menu__foot a {
    text-decoration: none;
  }

  @media (max-width: 860px) {
    .nav__links {
      display: none;
    }
    .nav__toggle {
      display: block;
    }
  }
</style>

<script>
  const navEl = document.querySelector<HTMLElement>('[data-nav]')!;
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;
  const hero = document.querySelector<HTMLElement>('[data-hero]');

  // Light text over the hero photo; paper background once past it. Tucks away on scroll down.
  let lastY = window.scrollY;
  let ticking = false;
  const onScroll = () => {
    const y = window.scrollY;
    const threshold = hero ? hero.offsetHeight - navEl.offsetHeight : 40;
    navEl.classList.toggle('is-scrolled', y > threshold);
    const goingDown = y > lastY && y > window.innerHeight;
    if (!menu.classList.contains('is-open')) navEl.classList.toggle('is-hidden', goingDown);
    lastY = y;
    ticking = false;
  };
  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        requestAnimationFrame(onScroll);
        ticking = true;
      }
    },
    { passive: true },
  );
  window.addEventListener('resize', onScroll, { passive: true });
  onScroll();

  // Active section
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
  const sections = [...links]
    .map((a) => document.querySelector(a.getAttribute('href')!))
    .filter((s): s is Element => !!s);
  const spy = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((a) => a.classList.toggle('is-active', a.getAttribute('href') === `#${e.target.id}`));
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  sections.forEach((s) => spy.observe(s));

  // Mobile menu
  const setOpen = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
    navEl.classList.toggle('is-menu-open', open);
    if (open) {
      menu.hidden = false;
      navEl.classList.remove('is-hidden');
      requestAnimationFrame(() => menu.classList.add('is-open'));
    } else {
      menu.classList.remove('is-open');
      setTimeout(() => {
        if (!menu.classList.contains('is-open')) menu.hidden = true;
      }, 400);
    }
  };
  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
  window.matchMedia('(min-width: 861px)').addEventListener('change', (m) => m.matches && setOpen(false));
</script>
