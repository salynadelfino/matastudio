---
import { Image } from 'astro:assets';
import type { Slot } from '../data/images';

interface Props {
  slot: Slot;
  sizes: string;
  widths?: number[];
  loading?: 'lazy' | 'eager';
  class?: string;
  tone?: 'light' | 'mid' | 'dark';
}
const { slot, sizes, widths = [480, 800, 1200, 1600, 2200], loading = 'lazy', class: cls, tone = 'mid' } = Astro.props;
---

<div class:list={['photo', `tone-${tone}`, cls]}>
  {
    slot.src ? (
      <Image
        src={slot.src}
        alt={slot.alt}
        widths={widths.filter((w) => w <= slot.src!.width)}
        sizes={sizes}
        loading={loading}
        fetchpriority={loading === 'eager' ? 'high' : undefined}
        style={slot.focus ? `object-position:${slot.focus}` : undefined}
      />
    ) : (
      <div class="photo__ph" role="img" aria-label="Image placeholder">
        <span class="photo__brief micro">Image · {slot.brief}</span>
      </div>
    )
  }
</div>

<style>
  .photo {
    position: relative;
    overflow: hidden;
    background: #9a978f;
    isolation: isolate;
  }
  .photo::after {
    /* film grain */
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--grain);
    opacity: 0.32;
    mix-blend-mode: overlay;
    pointer-events: none;
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.06) brightness(0.97);
  }
  .photo__ph {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: flex-end;
    padding: clamp(0.9rem, 2vw, 1.4rem);
    background:
      radial-gradient(90% 70% at 30% 25%, rgba(255, 255, 255, 0.22), transparent 70%),
      radial-gradient(70% 60% at 80% 90%, rgba(0, 0, 0, 0.22), transparent 70%),
      var(--ph);
  }
  .tone-light .photo__ph { --ph: #b3afa7; }
  .tone-mid .photo__ph { --ph: #8f8c85; }
  .tone-dark .photo__ph { --ph: #3a3937; }
  .photo__brief {
    position: relative;
    z-index: 1;
    max-width: 30rem;
    font-size: 0.58rem;
    color: rgba(247, 245, 241, 0.75);
  }
</style>
