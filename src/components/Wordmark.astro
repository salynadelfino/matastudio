---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['wordmark', className]}>
  <svg class="mark" viewBox="0 0 32 20" aria-hidden="true">
    <path d="M1 10C6 2.5 26 2.5 31 10C26 17.5 6 17.5 1 10Z" fill="none" stroke="currentColor" stroke-width="1.4"></path>
    <circle cx="16" cy="10" r="4.2" fill="currentColor"></circle>
  </svg>
  <span class="name">MATA</span>
  <span class="studio">Studio</span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    line-height: 1;
  }
  .mark {
    width: 1.6rem;
    height: auto;
  }
  .name {
    font-family: var(--serif);
    font-variation-settings: 'opsz' 48;
    font-weight: 500;
    font-size: 1.2rem;
    letter-spacing: 0.08em;
  }
  .studio {
    font-family: var(--sans);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.7;
    transform: translateY(1px);
  }
</style>
