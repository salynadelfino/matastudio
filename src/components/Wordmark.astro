---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['wordmark', className]}>mata<span class="wordmark__studio">studio</span></span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--serif);
    font-variation-settings: 'opsz' 48;
    font-weight: 400;
    font-size: 1.55rem;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .wordmark__studio {
    font-family: var(--sans);
    font-size: 0.58rem;
    font-weight: 450;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }
</style>
