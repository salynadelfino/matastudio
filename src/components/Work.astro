---
import ProjectCard from './ProjectCard.astro';
import { projects } from '../data/projects';

// The layout cycles through five compositions, so any number of projects works.
const layout = [
  { cls: 'w-a', ratio: '4 / 3', sizes: '(max-width: 760px) 100vw, 58vw' },
  { cls: 'w-b', ratio: '4 / 5', sizes: '(max-width: 760px) 100vw, 33vw' },
  { cls: 'w-c', ratio: '4 / 5', sizes: '(max-width: 760px) 100vw, 33vw' },
  { cls: 'w-d', ratio: '3 / 2', sizes: '(max-width: 760px) 100vw, 50vw' },
  { cls: 'w-e', ratio: '21 / 9', sizes: '100vw' },
];
const hasPrior = projects.some((p) => p.attribution === 'prior');
---

<section class="section dark work" id="work" aria-labelledby="work-title">
  <div class="wrap">
    <div class="work__head">
      <p class="micro" data-reveal>Selected work</p>
      <h2 class="headline center" id="work-title" data-reveal>A little of what<br /><em>we’ve been working on.</em></h2>
      {
        hasPrior && (
          <p class="work__note center" data-reveal>
            Work marked <span class="micro">Prior experience</span> was delivered by our founder before MATA Studio.
          </p>
        )
      }
    </div>

    <div class="work__grid">
      {
        projects.map((project, i) => {
          const l = layout[i % layout.length];
          return (
            <div class={`work__item ${l.cls}`} style={`--ratio:${l.ratio}`} data-reveal>
              <ProjectCard project={project} index={i} sizes={l.sizes} />
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .work__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
    margin-bottom: clamp(4rem, 8vw, 7rem);
  }
  .work__head > .micro {
    margin: 0;
    color: rgba(247, 245, 241, 0.5);
  }
  .work__note {
    margin: 0;
    max-width: 30rem;
    font-size: 0.88rem;
    color: rgba(247, 245, 241, 0.6);
  }
  .work__note .micro {
    font-size: 0.6rem;
    color: var(--paper);
  }
  .work__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 1.5rem;
    row-gap: clamp(4rem, 8vw, 7rem);
  }
  .w-a { grid-column: 1 / span 7; }
  .w-b { grid-column: 9 / span 4; margin-top: clamp(4rem, 14vw, 13rem); }
  .w-c { grid-column: 2 / span 4; }
  .w-d { grid-column: 7 / span 6; margin-top: clamp(3rem, 10vw, 9rem); }
  .w-e { grid-column: 1 / -1; }
  @media (max-width: 760px) {
    .work__grid > * {
      grid-column: 1 / -1 !important;
      margin-top: 0 !important;
      --ratio: 4 / 3 !important;
    }
  }
</style>
