---
import { differentiators } from '../data/services';
const split = (t: string) => {
  const words = t.replace(/\.$/, '').split(' ');
  return [words.slice(0, -1).join(' '), words.at(-1)];
};
---

<section class="section why" id="why" aria-labelledby="why-title">
  <div class="wrap">
    <div class="why__head">
      <p class="micro" data-reveal>Why MATA</p>
      <h2 class="headline center" id="why-title" data-reveal>More than marketing.<br /><em>A little more perspective.</em></h2>
    </div>
    <ol class="why__list">
      {
        differentiators.map((d, i) => {
          const [caps, it] = split(d.title);
          return (
            <li data-reveal style={`--d:${i}`}>
              <span class="micro why__num">0{i + 1}</span>
              <h3>
                {caps} <em>{it}</em>
              </h3>
              <p>{d.body}</p>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<style>
  .why__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
    margin-bottom: clamp(3.5rem, 7vw, 6rem);
  }
  .why__head .micro {
    margin: 0;
    color: var(--muted);
  }
  .why__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2.5rem, 5vw, 5rem);
    text-align: center;
  }
  .why__num {
    display: block;
    color: var(--muted);
    margin-bottom: 1.25rem;
  }
  .why__list h3 {
    margin: 0 0 1rem;
    font-family: var(--serif);
    font-variation-settings: 'opsz' 22;
    font-weight: 400;
    font-size: clamp(1.3rem, 1.1rem + 0.7vw, 1.75rem);
    line-height: 1.15;
    text-transform: uppercase;
  }
  .why__list h3 em {
    text-transform: none;
  }
  .why__list p {
    margin: 0 auto;
    max-width: 30ch;
    font-size: 0.95rem;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .why__list {
      grid-template-columns: 1fr;
    }
  }
</style>
