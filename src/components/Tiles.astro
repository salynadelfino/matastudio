---
import Photo from './Photo.astro';
import { images } from '../data/images';

const tiles = [
  { caps: 'About', italic: 'the studio', href: '#about', slot: images.tileAbout, tone: 'light' as const },
  { caps: 'Our', italic: 'services', href: '#services', slot: images.tileServices, tone: 'mid' as const },
  { caps: 'Selected', italic: 'work', href: '#work', slot: images.tileWork, tone: 'dark' as const },
];
---

<nav class="tiles" aria-label="Explore">
  <ul class="wrap tiles__grid">
    {
      tiles.map((t, i) => (
        <li data-reveal style={`--d:${i}`}>
          <a href={t.href} class="tile">
            <Photo slot={t.slot} tone={t.tone} sizes="(max-width: 760px) 100vw, 30vw" class="tile__img" />
            <span class="tile__label">
              {t.caps} <em>{t.italic}</em>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .tiles {
    padding-block: clamp(3rem, 6vw, 5rem) clamp(4rem, 8vw, 7rem);
  }
  .tiles__grid {
    list-style: none;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
  }
  .tile {
    display: block;
    text-decoration: none;
  }
  .tile :global(.tile__img) {
    aspect-ratio: 1;
  }
  .tile :global(.tile__img > *) {
    transition: transform 1.4s var(--ease);
  }
  .tile:hover :global(.tile__img > *) {
    transform: scale(1.04);
  }
  .tile__label {
    display: inline-block;
    margin-top: 1rem;
    font-family: var(--serif);
    font-variation-settings: 'opsz' 22;
    font-size: clamp(1.15rem, 1rem + 0.5vw, 1.45rem);
    text-transform: uppercase;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.6s var(--ease);
  }
  .tile:hover .tile__label {
    background-size: 100% 1px;
  }
  .tile__label em {
    text-transform: none;
  }
  @media (max-width: 760px) {
    /* swipeable row on phones */
    .tiles__grid {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 72%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
      padding-bottom: 0.5rem;
    }
    .tiles__grid::-webkit-scrollbar {
      display: none;
    }
    .tiles__grid li {
      scroll-snap-align: start;
    }
  }
</style>
