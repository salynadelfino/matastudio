---
import Photo from './Photo.astro';
import { images } from '../data/images';
import { site } from '../data/site';
const { founder } = site;
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="wrap about__grid">
    <div class="about__media" data-reveal>
      <Photo slot={images.about} tone="light" sizes="(max-width: 860px) 100vw, 42vw" widths={[480, 800, 1086]} />
    </div>

    <div class="about__body">
      <p class="micro about__label" data-reveal>About</p>
      <h2 class="headline" id="about-title" data-reveal>A different<br /><em>perspective.</em></h2>

      <p class="about__define" data-reveal>
        <span class="about__word">ma·ta</span>
        <span class="micro">Indonesian, noun — eye</span>
      </p>

      <div class="about__copy">
        <p class="about__lede" data-reveal>
          MATA is the Indonesian word for eye. A simple word with a bigger idea behind it: the way we see things shapes
          the way we understand them.
        </p>
        <p data-reveal>
          We believe perspective changes everything, especially in business. How a brand is seen influences how it’s
          understood, who it attracts and ultimately, how it grows.
        </p>
        <p data-reveal>
          But being seen is only part of the equation. It’s about knowing what you want to be known for, communicating
          it with clarity and making sure the right people are paying attention.
        </p>
        <p data-reveal>
          Rooted in an appreciation for different perspectives and shaped by experience across cultures, industries and
          the commercial side of business, MATA brings together strategic thinking and creative execution to help
          businesses make their mark.
        </p>
        <p class="about__sign" data-reveal>
          Independent by nature. Considered by design. Based in Dubai, with a perspective that extends beyond it.
        </p>
      </div>

      <div class="founder" data-reveal>
        <p class="founder__name">{founder.name} <em>{founder.role.toLowerCase()}</em></p>
        <p class="founder__bio">{founder.bio}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 1.5rem;
    row-gap: 3.5rem;
    align-items: start;
  }
  .about__media {
    grid-column: 1 / span 5;
    position: sticky;
    top: 5.5rem;
  }
  .about__media :global(.photo) {
    aspect-ratio: 4 / 5;
  }
  .about__body {
    grid-column: 7 / span 6;
    max-width: 36rem;
    padding-top: clamp(0rem, 3vw, 3rem);
  }
  .about__label {
    margin: 0 0 1.75rem;
    color: var(--muted);
  }
  .about__define {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin: 2.5rem 0;
    padding-block: 1rem;
    border-block: 1px solid var(--line);
  }
  .about__word {
    font-family: var(--serif);
    font-variation-settings: 'opsz' 22;
    font-style: italic;
    font-size: 1.6rem;
    line-height: 1;
  }
  .about__define .micro {
    color: var(--muted);
  }
  .about__copy p {
    margin: 0 0 1.2em;
  }
  .about__copy .about__lede {
    font-family: var(--serif);
    font-variation-settings: 'opsz' 22;
    font-size: clamp(1.2rem, 1rem + 0.6vw, 1.45rem);
    line-height: 1.45;
  }
  .about__copy .about__sign {
    font-family: var(--serif);
    font-variation-settings: 'opsz' 22;
    font-style: italic;
    font-size: 1.1rem;
    margin-top: 1.75rem;
  }

  .founder {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .founder p {
    margin: 0;
  }
  .founder__name {
    font-family: var(--serif);
    font-variation-settings: 'opsz' 22;
    font-size: 1.25rem;
    text-transform: uppercase;
    margin-bottom: 0.6rem !important;
  }
  .founder__name em {
    text-transform: none;
    color: var(--muted);
    margin-left: 0.25rem;
  }
  .founder__bio {
    font-size: 0.92rem;
    color: var(--muted);
    max-width: 34rem;
  }

  @media (max-width: 860px) {
    .about__media,
    .about__body {
      grid-column: 1 / -1;
      position: static;
    }
    .about__media :global(.photo) {
      aspect-ratio: 4 / 5;
      max-height: 80svh;
    }
  }
</style>
