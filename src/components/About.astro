---
import { Image } from 'astro:assets';
import { site } from '../data/site';
const { founder } = site;
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="wrap about__grid">
    <p class="label about__label" data-reveal><span class="num">01</span> About</p>

    <h2 class="display h2 about__title" id="about-title" data-reveal-lines>
      <span class="line"><span style="--i:0">A different</span></span>
      <span class="line"><span style="--i:1"><em>perspective.</em></span></span>
    </h2>

    <aside class="define" data-reveal aria-label="Definition">
      <p class="define__word">ma·ta</p>
      <p class="define__meta"><em>noun</em> &nbsp;·&nbsp; Indonesian</p>
      <p class="define__sense">eye.</p>
    </aside>

    <div class="about__copy">
      <p class="lede" data-reveal>
        MATA means ‘eye’ in Indonesian. It’s a reflection of how we see the world of business: perspective matters.
      </p>
      <p data-reveal>
        We believe good businesses deserve to be seen. But visibility alone isn’t enough. It’s about building the
        right identity, communicating with purpose and creating a digital presence that makes people take notice.
      </p>
      <p data-reveal>
        MATA is an independent, founder-led studio combining marketing strategy, creative thinking and commercial
        experience to help businesses grow.
      </p>
      <p data-reveal>Based in Dubai, working with ambitious businesses wherever they are.</p>
    </div>

    <figure class="founder" data-reveal>
      <div class="founder__img">
        {
          founder.portrait ? (
            <Image
              src={founder.portrait}
              alt={`Portrait of ${founder.name}`}
              widths={[320, 480, 720]}
              sizes="(max-width: 760px) 40vw, 240px"
            />
          ) : (
            <div class="ph">
              <span>Portrait</span>
              <span>Placeholder · 4:5</span>
            </div>
          )
        }
      </div>
      <figcaption>
        <p class="founder__role">{founder.role}</p>
        <p class="founder__name">{founder.name}</p>
        <p class="founder__bio">{founder.bio}</p>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 1.5rem;
  }
  .about__label {
    grid-column: 1 / -1;
    margin: 0 0 2.5rem;
  }
  .about__title {
    grid-column: 1 / -1;
    margin-bottom: clamp(3rem, 8vw, 7rem);
  }
  .about__title .line:nth-child(2) {
    padding-left: 1.5em;
  }
  .about__title em {
    color: var(--olive);
  }

  .define {
    grid-column: 1 / span 4;
    align-self: start;
    padding-top: 1.25rem;
    border-top: 1px solid var(--espresso);
    max-width: 20rem;
  }
  .define p {
    margin: 0;
  }
  .define__word {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .define__meta {
    margin: 0.6rem 0 1.25rem !important;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .define__sense {
    font-family: var(--serif);
    font-size: 1.1rem;
    line-height: 1.5;
  }
  .define__sense span {
    font-family: var(--sans);
    font-size: 0.75rem;
    color: var(--muted);
    margin-right: 0.5rem;
  }

  .about__copy {
    grid-column: 6 / span 6;
    max-width: 40rem;
  }
  .about__copy > p {
    margin: 0 0 1.25em;
  }
  .about__copy .lede {
    margin-bottom: 1.5em;
  }

  .founder {
    grid-column: 6 / span 6;
    margin: clamp(3rem, 6vw, 5rem) 0 0;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: minmax(0, 11rem) 1fr;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: start;
  }
  .founder__img {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--paper);
  }
  .founder__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.15) contrast(1.02);
  }
  .ph {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 0.8rem;
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px dashed rgba(42, 29, 21, 0.25);
  }
  .founder figcaption p {
    margin: 0;
  }
  .founder__role {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .founder__name {
    font-family: var(--serif);
    font-size: 1.75rem;
    font-weight: 350;
    letter-spacing: -0.02em;
    margin: 0.35rem 0 0.9rem !important;
  }
  .founder__bio {
    font-size: 0.95rem;
    color: var(--muted);
    max-width: 34rem;
  }

  @media (max-width: 860px) {
    .define,
    .about__copy,
    .founder {
      grid-column: 1 / -1;
    }
    .define {
      margin-bottom: 3rem;
    }
  }
  @media (max-width: 480px) {
    .founder {
      grid-template-columns: 7.5rem 1fr;
    }
    .founder__name {
      font-size: 1.4rem;
    }
  }
</style>
