---
import { Image } from 'astro:assets';
import Photo from './Photo.astro';
import { images } from '../data/images';
import { site } from '../data/site';
const { founder } = site;
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="wrap about__grid">
    <div class="about__media" data-reveal>
      <Photo slot={images.about} tone="light" sizes="(max-width: 860px) 100vw, 42vw" />
    </div>

    <div class="about__body">
      <p class="micro about__label" data-reveal>About</p>
      <h2 class="headline" id="about-title" data-reveal>A different<br /><em>perspective.</em></h2>

      <p class="about__define" data-reveal>
        <span class="about__word">ma·ta</span>
        <span class="micro">Indonesian, noun — eye</span>
      </p>

      <div class="about__copy">
        <p class="body-lg" data-reveal>
          MATA means ‘eye’ in Indonesian. It’s a reflection of how we see the world of business: perspective matters.
        </p>
        <p data-reveal>
          We believe good businesses deserve to be seen. But visibility alone isn’t enough. It’s about building the
          right identity, communicating with purpose and creating a digital presence that makes people take notice.
        </p>
        <p data-reveal>
          MATA is an independent, founder-led studio combining marketing strategy, creative thinking and commercial
          experience to help businesses grow. Based in Dubai, working with ambitious businesses wherever they are.
        </p>
      </div>

      <figure class="founder" data-reveal>
        <div class="founder__img">
          {
            founder.portrait ? (
              <Image src={founder.portrait} alt={`Portrait of ${founder.name}`} widths={[160, 320]} sizes="96px" />
            ) : (
              <span class="micro">Portrait</span>
            )
          }
        </div>
        <figcaption>
          <p class="founder__name">{founder.name} <em>{founder.role.toLowerCase()}</em></p>
          <p class="founder__bio">{founder.bio}</p>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 1.5rem;
    row-gap: 3.5rem;
    align-items: start;
  }
  .about__media {
    grid-column: 1 / span 5;
    position: sticky;
    top: 5.5rem;
  }
  .about__media :global(.photo) {
    aspect-ratio: 4 / 5;
  }
  .about__body {
    grid-column: 7 / span 6;
    max-width: 36rem;
    padding-top: clamp(0rem, 3vw, 3rem);
  }
  .about__label {
    margin: 0 0 1.75rem;
    color: var(--muted);
  }
  .about__define {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin: 2.5rem 0;
    padding-block: 1rem;
    border-block: 1px solid var(--line);
  }
  .about__word {
    font-family: var(--serif);
    font-variation-settings: 'opsz' 22;
    font-style: italic;
    font-size: 1.6rem;
    line-height: 1;
  }
  .about__define .micro {
    color: var(--muted);
  }
  .about__copy p {
    margin: 0 0 1.2em;
  }
  .about__copy .body-lg {
    font-family: var(--serif);
    font-variation-settings: 'opsz' 22;
    font-size: clamp(1.2rem, 1rem + 0.6vw, 1.45rem);
    line-height: 1.45;
  }

  .founder {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1.5rem;
    align-items: start;
    margin: 3rem 0 0;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .founder__img {
    aspect-ratio: 4 / 5;
    background: var(--bone);
    display: flex;
    align-items: flex-end;
    padding: 0.5rem;
    overflow: hidden;
  }
  .founder__img .micro {
    font-size: 0.52rem;
    color: var(--muted);
  }
  .founder__img :global(img) {
    width: calc(100% + 1rem);
    height: calc(100% + 1rem);
    margin: -0.5rem;
    object-fit: cover;
    filter: grayscale(1);
  }
  .founder p {
    margin: 0;
  }
  .founder__name {
    font-family: var(--serif);
    font-variation-settings: 'opsz' 22;
    font-size: 1.25rem;
    text-transform: uppercase;
    margin-bottom: 0.6rem !important;
  }
  .founder__name em {
    text-transform: none;
    color: var(--muted);
    margin-left: 0.25rem;
  }
  .founder__bio {
    font-size: 0.92rem;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .about__media,
    .about__body {
      grid-column: 1 / -1;
      position: static;
    }
    .about__media :global(.photo) {
      aspect-ratio: 4 / 3;
    }
  }
</style>
