---
import Photo from './Photo.astro';
import { attributionLabel, type Project } from '../data/projects';

interface Props {
  project: Project;
  index: number;
  sizes: string;
  feature?: boolean;
}
const { project: p, index, sizes, feature = false } = Astro.props;
const tones = ['mid', 'light', 'dark', 'mid', 'light'] as const;
const Tag = p.href ? 'a' : 'div';
const kicker = [p.category, p.year].filter(Boolean).join(' · ');
---

<article class:list={['project', { 'is-feature': feature }]}>
  <Tag class="project__frame" {...p.href ? { href: p.href, target: '_blank', rel: 'noopener' } : {}}>
    <Photo
      slot={{ src: p.image, alt: p.imageAlt ?? p.title, brief: p.imageBrief ?? 'Project image' }}
      tone={tones[index % tones.length]}
      sizes={sizes}
    />
    {p.href && <span class="visually-hidden">View {p.title} (opens in a new tab)</span>}
  </Tag>

  <div class="project__meta">
    <p class="micro project__kicker">{kicker}</p>
    <h3 class="project__title">
      {p.title}
      {p.placeholder && <span class="micro project__flag">Placeholder</span>}
    </h3>
    {p.sector && <p class="project__sector">{p.sector}</p>}
    <p class="project__summary">{p.summary}</p>

    {
      feature && (p.brief || p.approach || p.outcome) && (
        <dl class="project__detail">
          {p.brief && (
            <div>
              <dt class="micro">The brief</dt>
              <dd>{p.brief}</dd>
            </div>
          )}
          {p.approach && (
            <div>
              <dt class="micro">What we did</dt>
              <dd>{p.approach}</dd>
            </div>
          )}
          {p.outcome && (
            <div class="project__outcome">
              <dt class="micro">The result</dt>
              <dd>{p.outcome}</dd>
            </div>
          )}
        </dl>
      )
    }

    <p class="project__scope">
      <span class:list={['micro project__by', `is-${p.attribution}`]}>{attributionLabel[p.attribution]}</span>
      <span>{p.scope.join(' · ')}</span>
    </p>
    {
      p.href && (
        <a class="micro project__link link" href={p.href} target="_blank" rel="noopener">
          Visit the site
        </a>
      )
    }
  </div>
</article>

<style>
  .project__frame {
    display: block;
    overflow: hidden;
  }
  .project__frame :global(.photo) {
    aspect-ratio: var(--ratio, 4 / 3);
  }
  .project__frame :global(.photo > *) {
    transition: transform 1.4s var(--ease);
  }
  .project:hover .project__frame :global(.photo > *) {
    transform: scale(1.03);
  }
  .project__meta p {
    margin: 0;
  }
  .project__kicker {
    margin-top: 1.25rem !important;
    color: rgba(247, 245, 241, 0.55);
  }
  .project__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0.55rem 0 0.4rem;
    font-family: var(--serif);
    font-variation-settings: 'opsz' 22;
    font-weight: 400;
    font-size: clamp(1.4rem, 1.1rem + 0.9vw, 2rem);
    line-height: 1.1;
    text-transform: uppercase;
  }
  .project__sector {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.05rem;
    color: rgba(247, 245, 241, 0.75);
    margin-bottom: 0.9rem !important;
  }
  .project__flag {
    font-size: 0.55rem;
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--line-light);
    color: rgba(247, 245, 241, 0.6);
  }
  .project__summary {
    max-width: 44ch;
    font-size: 0.95rem;
    color: rgba(247, 245, 241, 0.72);
  }
  .project__detail {
    display: grid;
    gap: 1.25rem;
    margin: 2rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-light);
  }
  .project__detail dt {
    color: rgba(247, 245, 241, 0.5);
    margin-bottom: 0.35rem;
  }
  .project__detail dd {
    margin: 0;
    font-size: 0.92rem;
    color: rgba(247, 245, 241, 0.78);
    max-width: 46ch;
  }
  .project__outcome dd {
    font-family: var(--serif);
    font-variation-settings: 'opsz' 22;
    font-size: 1.15rem;
    line-height: 1.4;
    color: var(--paper);
  }
  .project__scope {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: 1.5rem !important;
    font-size: 0.82rem;
    color: rgba(247, 245, 241, 0.6);
  }
  .project__by {
    font-size: 0.55rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--line-light);
    color: var(--paper);
  }
  .project__by.is-mata {
    background: var(--sage);
    border-color: var(--sage);
  }
  .project__link {
    display: inline-block;
    margin-top: 1.5rem;
  }

  /* Featured: image and story side by side */
  .is-feature {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 1.5rem;
    row-gap: 2rem;
    align-items: center;
  }
  .is-feature .project__frame {
    grid-column: 1 / span 7;
    --ratio: 4 / 3;
  }
  .is-feature .project__meta {
    grid-column: 9 / span 4;
  }
  .is-feature .project__kicker {
    margin-top: 0 !important;
  }
  .is-feature .project__title {
    font-size: clamp(1.8rem, 1.3rem + 1.6vw, 2.8rem);
  }
  @media (max-width: 960px) {
    .is-feature .project__frame,
    .is-feature .project__meta {
      grid-column: 1 / -1;
    }
  }
</style>
