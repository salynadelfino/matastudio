---
import Photo from './Photo.astro';
import { images } from '../data/images';
---

<section class="hero" id="top" data-hero aria-labelledby="hero-title">
  <Photo slot={images.hero} sizes="100vw" loading="eager" tone="mid" class="hero__photo" />
  <div class="hero__shade" aria-hidden="true"></div>

  <h1 class="hero__mark" id="hero-title">
    <span class="visually-hidden">MATA Studio</span>
    <span class="hero__word blink blink--load" aria-hidden="true">mata</span>
  </h1>
</section>

<section class="dark statement" aria-label="Introduction">
  <div class="wrap statement__inner">
    <h2 class="headline center statement__title" data-reveal>
      Change the way<br /><em>you’re seen.</em>
    </h2>
    <div class="statement__copy center">
      <p class="statement__lede" data-reveal style="--d:1">
        Every business has a story. How it’s told, where it shows up and the impression it leaves make all the
        difference.
      </p>
      <p data-reveal style="--d:2">
        We’re an independent digital marketing studio bringing together strategy, creativity and commercial thinking to
        help ambitious businesses shape their presence, find their people and make a lasting impression.
      </p>
    </div>
    <div data-reveal style="--d:3"><a class="btn" href="#contact">Let’s talk</a></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: clamp(30rem, 88svh, 62rem);
    color: var(--paper);
    overflow: hidden;
  }
  .hero :global(.hero__photo) {
    position: absolute;
    inset: 0;
    animation: settle 2.6s var(--ease) both;
  }
  .hero :global(.photo__ph) {
    align-items: flex-start;
    justify-content: center;
    padding-top: calc(var(--nav-h) + 0.5rem);
    text-align: center;
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(0, 0, 0, 0.18), rgba(0, 0, 0, 0.18)),
      linear-gradient(to bottom, rgba(0, 0, 0, 0.25), transparent 30%, transparent 70%, rgba(0, 0, 0, 0.25));
    pointer-events: none;
  }
  .hero__mark {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    transform: translateY(-46%);
    margin: 0;
    text-align: center;
    font-family: var(--serif);
    font-weight: 400;
    font-variation-settings: 'opsz' 96;
    font-size: min(40vw, 46rem);
    line-height: 1;
    letter-spacing: -0.045em;
    pointer-events: none;
  }
  .hero__word {
    display: inline-block;
    padding-inline: 0.06em;
  }
  @keyframes settle {
    from {
      transform: scale(1.08);
      filter: brightness(0.85);
    }
  }

  .statement__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.25rem;
    padding-block: clamp(5.5rem, 13vw, 10rem);
  }
  .statement__title {
    font-size: clamp(2.1rem, 1.2rem + 3.6vw, 4.6rem);
  }
  .statement__copy {
    display: grid;
    gap: 1.1rem;
    max-width: 38rem;
  }
  .statement__copy p {
    margin: 0;
    color: rgba(247, 245, 241, 0.68);
  }
  .statement__copy .statement__lede {
    font-family: var(--serif);
    font-variation-settings: 'opsz' 22;
    font-size: clamp(1.15rem, 1rem + 0.5vw, 1.4rem);
    line-height: 1.45;
    color: var(--paper);
  }
  @media (max-width: 560px) {
    .hero {
      height: 78svh;
    }
    .hero__mark {
      font-size: 44vw;
    }
  }
</style>
