---
import Photo from './Photo.astro';
import { images } from '../data/images';
---

<section class="hero" id="top" data-hero aria-labelledby="hero-title">
  <Photo slot={images.hero} sizes="100vw" loading="eager" tone="mid" class="hero__photo" />
  <div class="hero__shade" aria-hidden="true"></div>

  <h1 class="hero__mark" id="hero-title">
    <span class="visually-hidden">MATA Studio</span>
    <span class="hero__word" aria-hidden="true">
      {['m', 'a', 't', 'a'].map((l, i) => <span style={`--i:${i}`}>{l}</span>)}
    </span>
  </h1>

  <div class="wrap hero__foot micro">
    <span>Dubai-based</span>
    <span>Working everywhere</span>
  </div>
</section>

<section class="dark statement" aria-label="Introduction">
  <div class="wrap statement__inner">
    <p class="micro statement__kicker" data-reveal>MATA Studio — Dubai</p>
    <p class="headline center statement__title" data-reveal style="--d:1">
      Change the way<br /><em>you’re</em> seen.
    </p>
    <p class="statement__lede center" data-reveal style="--d:2">
      We’re a boutique digital marketing studio helping ambitious businesses build their presence, find their
      audience and stand out for the right reasons.
    </p>
    <div data-reveal style="--d:3"><a class="btn" href="#contact">Let’s talk</a></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: clamp(30rem, 88svh, 62rem);
    color: var(--paper);
    overflow: hidden;
  }
  .hero :global(.hero__photo) {
    position: absolute;
    inset: 0;
    animation: settle 2.4s var(--ease) both;
  }
  .hero :global(.photo__ph) {
    align-items: flex-start;
    justify-content: center;
    padding-top: calc(var(--nav-h) + 0.5rem);
    text-align: center;
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.22), transparent 30%, transparent 70%, rgba(0, 0, 0, 0.2));
    pointer-events: none;
  }
  .hero__mark {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    transform: translateY(-46%);
    margin: 0;
    text-align: center;
    font-family: var(--serif);
    font-weight: 400;
    font-variation-settings: 'opsz' 96;
    font-size: min(40vw, 46rem);
    line-height: 1;
    letter-spacing: -0.045em;
    pointer-events: none;
  }
  .hero__word {
    display: inline-flex;
  }
  .hero__word span {
    display: inline-block;
    animation: rise 1.6s var(--ease) both;
    animation-delay: calc(0.25s + var(--i) * 0.09s);
  }
  .hero__foot {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.5rem;
    display: flex;
    justify-content: space-between;
  }
  @keyframes settle {
    from {
      transform: scale(1.08);
      filter: brightness(0.85);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.12em);
    }
  }

  .statement__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    padding-block: clamp(5.5rem, 13vw, 10rem);
  }
  .statement__kicker {
    margin: 0;
    color: rgba(247, 245, 241, 0.55);
  }
  .statement__title {
    font-size: clamp(2.1rem, 1.2rem + 3.6vw, 4.6rem);
  }
  .statement__lede {
    margin: 0;
    max-width: 36rem;
    color: rgba(247, 245, 241, 0.7);
  }
  @media (max-width: 560px) {
    .hero {
      height: 78svh;
    }
    .hero__mark {
      font-size: 44vw;
    }
  }
</style>
