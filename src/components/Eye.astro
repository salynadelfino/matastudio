---
/**
 * The MATA eye: an almond aperture with a lens-like iris that quietly follows the cursor
 * and blinks now and then, inside a slowly turning ring of type.
 */
---

<div class="eye" data-eye aria-hidden="true">
  <svg viewBox="0 0 400 400">
    <defs>
      <path id="eye-ring" d="M200,200 m-176,0 a176,176 0 1,1 352,0 a176,176 0 1,1 -352,0"></path>
      <clipPath id="eye-clip">
        <path d="M44,200 C110,98 290,98 356,200 C290,302 110,302 44,200 Z"></path>
      </clipPath>
    </defs>

    <g class="eye__ring">
      <text>
        <textPath href="#eye-ring" textLength="1100" lengthAdjust="spacing">
          Change the way you’re seen — MATA Studio — Dubai — Perspective —
        </textPath>
      </text>
    </g>

    <!-- framing ticks -->
    <g class="eye__ticks">
      <line x1="200" y1="44" x2="200" y2="66"></line>
      <line x1="200" y1="334" x2="200" y2="356"></line>
      <line x1="14" y1="200" x2="30" y2="200"></line>
      <line x1="370" y1="200" x2="386" y2="200"></line>
    </g>

    <g class="eye__lid">
      <g clip-path="url(#eye-clip)">
        <g class="eye__iris" data-iris>
          <circle cx="200" cy="200" r="70" class="iris-fill"></circle>
          <circle cx="200" cy="200" r="70" class="hair"></circle>
          <circle cx="200" cy="200" r="56" class="hair faint"></circle>
          <circle cx="200" cy="200" r="44" class="hair faint"></circle>
          <circle cx="200" cy="200" r="28" class="pupil"></circle>
          <circle cx="214" cy="186" r="6" class="glint"></circle>
        </g>
      </g>
      <path class="eye__outline" d="M44,200 C110,98 290,98 356,200 C290,302 110,302 44,200 Z"></path>
    </g>
  </svg>
</div>

<style>
  .eye {
    width: 100%;
    aspect-ratio: 1;
    color: var(--espresso);
  }
  .eye svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .eye__ring {
    transform-origin: 200px 200px;
    animation: spin 60s linear infinite;
  }
  .eye__ring text {
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    fill: currentColor;
    opacity: 0.75;
  }
  .eye__ticks line,
  .hair,
  .eye__outline {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .eye__outline {
    stroke-width: 1.25;
  }
  .faint {
    opacity: 0.35;
  }
  .iris-fill {
    fill: var(--sage);
    opacity: 0.35;
  }
  .pupil {
    fill: currentColor;
  }
  .glint {
    fill: var(--ivory);
  }
  .eye__lid {
    transform-origin: 200px 200px;
    transition: transform 0.14s ease-in;
  }
  .eye.is-blinking .eye__lid {
    transform: scaleY(0.04);
  }
  .eye__iris {
    transition: transform 0.9s var(--ease);
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>

<script>
  const eye = document.querySelector<HTMLElement>('[data-eye]');
  const iris = eye?.querySelector<SVGGElement>('[data-iris]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (eye && iris && !reduce) {
    // Follow the pointer (desktop) — limited travel so it stays calm.
    if (window.matchMedia('(pointer: fine)').matches) {
      let raf = 0;
      window.addEventListener(
        'pointermove',
        (e) => {
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(() => {
            const r = eye.getBoundingClientRect();
            const dx = e.clientX - (r.left + r.width / 2);
            const dy = e.clientY - (r.top + r.height / 2);
            const dist = Math.hypot(dx, dy) || 1;
            const k = Math.min(dist / 600, 1);
            iris.style.transform = `translate(${(dx / dist) * 46 * k}px, ${(dy / dist) * 22 * k}px)`;
          });
        },
        { passive: true },
      );
    } else {
      // Touch: a slow, occasional glance.
      const glances = [
        [0, 0],
        [-30, 6],
        [28, -8],
        [0, 10],
      ];
      let g = 0;
      setInterval(() => {
        g = (g + 1) % glances.length;
        iris.style.transform = `translate(${glances[g][0]}px, ${glances[g][1]}px)`;
      }, 3200);
    }

    // Occasional blink
    const blink = () => {
      eye.classList.add('is-blinking');
      setTimeout(() => eye.classList.remove('is-blinking'), 150);
      setTimeout(blink, 4000 + Math.random() * 5000);
    };
    setTimeout(blink, 2600);
  }
</script>
